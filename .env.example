# ==========================================
# Portfolio Email Service Configuration (.env)
# ==========================================

# 1. RESEND API KEY (Required)
# Create a free account at https://resend.com, generate an API key (starts with 're_'), and paste it below:
RESEND_API_KEY=re_your_actual_resend_api_key_here

# 2. RECIPIENT EMAIL ADDRESS (Where you want to receive messages)
CONTACT_EMAIL=rishabhkumar3800@gmail.com

# 3. SENDER ADDRESS
# For testing with Resend's free tier, use the default sandbox sender:
# FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# When you verify your own custom domain on Resend, change it to:
# FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# 4. LOCAL SERVER PORT
PORT=3000
